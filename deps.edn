{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers — an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 :jolt/min-version "0.8.3"

 :paths ["src" "resources"]

 ;; Git deps are fetched into ~/.jolt/gitlibs by jolt. Full SHAs only —
 ;; `git fetch` can't resolve short ones.
 :deps {;; provider calls (clj-http-lite over jolt.ffi sockets + OpenSSL + libz)
        ;; :conn-timeout is honoured from v0.0.3 on: the connect itself is
        ;; bounded through a non-blocking socket, which needs jolt 0.6.8's
        ;; :varargs FFI marker (fcntl is variadic, and on Apple arm64 a
        ;; fixed-arity binding silently corrupts the stack-passed argument).
        ;; v0.0.8: reads are interruptible (poll in 250 ms slices, the
        ;; interrupt flag checked between them), so a cancelled provider call
        ;; returns within a slice rather than after the socket timeout
        ;; (RFC-013, karamazov-3cll.10).
        jolt-lang/http-client
        {:git/url "https://github.com/jolt-lang/http-client"
         :git/tag "v0.0.8"
         :git/sha "ccce992d6e3d0035a5ffd1d4364cdb39df4af2f0"}

        ;; durable sessions: jdbc.core over the system libsqlite3 via jolt.ffi
        jolt-lang/db
        {:git/url "https://github.com/jolt-lang/db"
         :git/tag "v0.4.0"
         :git/sha "d85f391ca521da389b935c38f3d78b30eaa23208"}

        ;; nREPL middleware (sessions, interruptible eval, completion, lookup) so
        ;; an editor can drive the running harness. See core/start-nrepl!. The
        ;; project image runs this same sha (repl/image.clj nrepl-sha, held
        ;; equal by base-test). v0.1.2: the client transport's recv is
        ;; interruptible, so a cancelled image eval frees its reader within a
        ;; slice (RFC-013, karamazov-3cll.10).
        jolt-lang/nrepl
        {:git/url "https://github.com/jolt-lang/nrepl"
         :git/tag "v0.1.2"
         :git/sha "6e8cfa214dbd43c9ed72358f3d1191bb29a695cd"}

        ;; OpenSSL/SecureRandom shims. http-client pulls this in too; jolt.deps
        ;; reconciles the duplicate libssl/libcrypto natives to a single load.
        jolt-lang/jolt-crypto
        {:git/url "https://github.com/jolt-lang/jolt-crypto"
         :git/sha "584a4d32094f0a72613d028deb944de00cd9fc11"}

         org.clojure/data.json
         {:git/url "https://github.com/clojure/data.json"
          :git/sha "94463ffb54482427fd9b31f264b06bff6dcfd557"}

         ;; instaparse (EPL), for the shell policy's lexer: a POSIX-subset
         ;; grammar in place of a hand-rolled quote-aware scanner
         ;; (karamazov-41a.5). The jolt port — .cljc sources, no deps of its
         ;; own; needs jolt past 0.6.8 (jolt-lang/jolt#567), which the
         ;; :jolt/min-version above already requires.
         jolt-lang/instaparse
         {:git/url "https://github.com/jolt-lang/instaparse"
          :git/sha "111fae05f30ea0c4f6b13945d9505901649abc6d"}

         ;; Selmer renders every prompt template ({{...}} placeholders). Its
         ;; java.time FormatStyle use needs jolt-lang/time (below); prompts
         ;; carry code, so escaping is off (samizdat.prompt).
         selmer/selmer {:mvn/version "1.13.5"}

        ;; src/mycelium — schema contracts and validation. malli.generator
        ;; hard-requires test.check at namespace load, and mycelium.dev loads
        ;; malli.generator, so test.check rides along in the main deps.
        metosin/malli {:mvn/version "0.17.0"}
        org.clojure/test.check {:mvn/version "1.1.1"}

        ;; src/samizdat/symbolic — the rule layer's substrate (RFC/karamazov-41a).
        ;; Runs unmodified: 423 tests, 658 assertions, 0 failures under jolt.
        ;; No fork and no jolt port — the Maven artifact ships the .clj sources
        ;; jolt compiles, and the pom's only non-provided dep is clojure itself
        ;; (clojurescript is <scope>provided</scope>, so it does not ride along).
        ;; Requiring core.logic + fd + pldb + unifier costs ~40ms of boot.
        org.clojure/core.logic {:mvn/version "1.1.1"}

        ;; ebb — missionary ported to jolt: cancellable tasks (sp, via blk,
        ;; timeout, join) and flows (observe, relieve). The concurrency
        ;; substrate RFC-013 specifies; adopted under karamazov-3cll. Pure
        ;; Clojure, no deps of its own; requiring ebb.core costs ~60ms of
        ;; boot (measured 2026-09-06, warm cache). The checkout at
        ;; ~/src/jlt-commons/ebb is ours to change; pin a full sha here.
        ;; v0.1.3 carries the fix for a cancelled ap spinning forever
        ;; (ebb PR #7, found by the supervisor stream here).
        jlt-commons/ebb
        {:git/url "https://github.com/jlt-commons/ebb"
         :git/tag "v0.1.3"
         :git/sha "5f6a4f3adcfcb8cace4cbb691c7be6cb0d15724b"}

        ;; clojure.tools.logging ported to jolt (stderr backend, :info+ default)
        org.clojure/tools.logging
        {:git/url "https://github.com/jolt-lang/logging"
         :git/sha "ec6747e55583118d881faf4ab41e68d7e587ce4c"}

        ;; java.time host shim. tools.logging formats timestamps with
        ;; DateTimeFormatter, which core does not provide (RFC 0008), so
        ;; logging anything without this dep throws at the first log call.
        ;; bc85090 brings DateTimeFormatterBuilder.appendFraction (PR #7/#8),
        ;; which malli.transform's date formatter needs at namespace load.
        jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time"
         :git/sha "bc85090dae95d103ba04f4ea9687945cf46fb19e"}}

 ;; The vendored HTTP server (src/ring_chez/adapter.clj) binds BSD sockets
 ;; through the running process's own libc symbols, so they must be loaded
 ;; before that namespace is required.
 :jolt/native [{:name "libc (POSIX sockets)" :process true}]

 ;; Bake resources/ into the binary, so io/resource resolves with no files on
 ;; disk and a built harness runs from any cwd.
 ;;
 ;; `jolt build` links code and deps, not data: without this the binary
 ;; resolved gates.edn, phases.edn, wordlists.edn, prompts/, manifests/ and
 ;; cells/ RELATIVE TO THE WORKING DIRECTORY, so it booted from the project
 ;; root and died anywhere else with "Cannot open <nil> as a Reader" — a
 ;; nil resource handed to slurp, from the first reload-config! in
 ;; system/start!. Every "works interpreted and inside an AOT binary" comment
 ;; on an io/resource seam in src was true only by accident of cwd.
 :jolt/build {:embed ["resources"]}

 :nrepl/middleware [nrepl.middleware/default-middleware]

 ;; "gui" and "tui" are SOURCE paths here, not their toolkits: neither
 ;; alias's deps ride along. That is the discipline both front ends keep —
 ;; everything except the toolkit's own run loop is written toolkit-free
 ;; (the TUI's widgets return hiccup, which is data), so the suite covers
 ;; them without cmake, GTK, or a terminal.
 :aliases {:test {:extra-paths ["test" "gui" "tui"]
                  :main-opts ["-m" "samizdat.test-runner"]}
           ;; The dev tree (the nREPL client, the ebb spike) plus the tests, so
           ;; a live image can run the suite without paying startup — with
           ;; :test too, for the gui path: `jolt -A:dev:test nrepl-server 7899`,
           ;; then (require 'samizdat.test-runner) (samizdat.test-runner/run).
           ;; Not :reload-all on the runner: that dies inside jolt.time
           ;; (karamazov-cc3a). See AGENTS.md, "Live development over nREPL".
           :dev  {:extra-paths ["dev" "test"]}

           ;; The GUI is an optional component and a strict HTTP client of the
           ;; server: its source root and its GTK/GL deps live ONLY under this
           ;; alias, so `jolt serve` and `jolt -M:test` stay headless and never
           ;; load a native toolkit.
           :gui  {:extra-paths ["gui"]
                  :extra-deps
                  {;; glimmer is now the portable reactive core only — ratom,
                   ;; the component model and the reconciler — and knows about
                   ;; no toolkit. v0.1.0 is the release that split GTK out.
                   ;; It still carries the two fixes this GUI needs: the swap!
                   ;; nil-argument fix, and :scroll-top on :scrolled, without
                   ;; which the inspector opens part-way down the previous
                   ;; selection.
                   jolt-lang/glimmer
                   {:git/url "https://github.com/jolt-lang/glimmer.git"
                    :git/tag "v0.1.0"
                    :git/sha "5581c331c51aff989259b9e8e92ec920fe5e6741"}
                   ;; The GTK4 backend: the widgets, the prop/signal wiring and
                   ;; the app loop, registered through glimmer.backend. It also
                   ;; owns the GTK/GLib :jolt/native declarations, which is why
                   ;; none appear here. `glimmer.ffi` and `glimmer.widget` live
                   ;; here now as `glimmer-gtk.ffi` and `glimmer-gtk.widget`.
                   jolt-lang/glimmer-gtk
                   {:git/url "https://github.com/jolt-lang/glimmer-gtk.git"
                    :git/tag "v0.1.0"
                    :git/sha "ce79d45698d36ccf496397bb85974e3cce6abfd8"}
                   ;; Pinned past the split too: glimmer-gl.gtk registers
                   ;; :gl-area and :scale into the widget registry, which now
                   ;; lives in glimmer-gtk, so an older glimmer-gl fails to
                   ;; load with `Could not locate glimmer/ffi`.
                   jolt-lang/glimmer-gl
                   {:git/url "https://github.com/jolt-lang/glimmer-gl.git"
                    :git/tag "v0.1.0"
                    :git/sha "ae9a53291c553e89dde79a90389224f46e5e7fa8"}}
                  :main-opts ["-m" "samizdat.gui.core"]}

           ;; The TUI, on the same terms as the GUI: its own source root, its
           ;; own toolkit dep, and a strict HTTP client of the server. `jolt
           ;; serve` and `jolt -M:test` never load it.
           ;;
           ;; :local/root while ftxui-jolt is unreleased. It carries a C++
           ;; shim that has to be COMPILED (`jolt native` in its checkout,
           ;; needing cmake and a C++17 compiler) — a git dep would resolve
           ;; the sources into ~/.jolt/gitlibs with no build step and fail at
           ;; the first FFI call. Pin a :git/sha here once it tags a release
           ;; that ships the shared object.
           :tui  {:extra-paths ["tui"]
                  :extra-deps
                  {jlt-commons/ftxui-jolt
                   {:local/root "/Users/yogthos/src/jlt-commons/ftxui-jolt"}}
                  :main-opts ["-m" "samizdat.tui.core"]}

           ;; The half of the TUI the main suite cannot cover: what the
           ;; TOOLKIT does with the hiccup — that a click on a fold's header
           ;; actually opens it. It drives real FTXUI widgets headlessly, so
           ;; it needs no terminal, but it does need the compiled shim, which
           ;; is why it is its own alias rather than part of `jolt test`.
           ;;
           ;;     jolt tui-test
           :tui-test {:extra-paths ["tui" "test-tui"]
                      :extra-deps
                      {jlt-commons/ftxui-jolt
                       {:local/root "/Users/yogthos/src/jlt-commons/ftxui-jolt"}}
                      :main-opts ["-m" "samizdat.tui.test-runner"]}}

 :tasks {serve {:doc "start the harness (HTTP + nREPL) and park"
                :main-opts ["-m" "samizdat.core"]}
         ;; A shell-string task, because a :tasks :main-opts entry cannot carry
         ;; an -A alias — main-opts are only ever main-opts.
         dev   "jolt -A:dev -m samizdat.core"
         smoke {:doc "Phase 0 platform probes: z3, swipl, sqlite, https, server"
                :main-opts ["-m" "samizdat.smoke"]}
          ;; The ulimit raise on `test` is load-bearing: the suite holds ~260
          ;; fds at peak and the default 256 soft limit made the last five
          ;; namespaces error spuriously (socket() failed / sqlite open failed
          ;; {:rc 14}) — provenance A-3. `;` not `&&` so a hardened
          ;; environment where 1024 exceeds the hard limit still runs.
          test  "(ulimit -n 1024 2>/dev/null; jolt -M:test)"
         gui   "jolt -M:gui"
         tui   "jolt -M:tui"
         ;; A shell string, not :main-opts: a task's main-opts cannot carry an
         ;; -M alias, and this one needs the ftxui dep.
         tui-test "jolt -M:tui-test"
         export {:doc "runs that shipped and verified, as JSONL trajectories — or with --verdicts, every judgement labelled by its outcome: jolt export <db> [out.jsonl] [--verdicts]"
                 :main-opts ["-m" "samizdat.export"]}}}
