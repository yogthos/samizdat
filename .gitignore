.nrepl-port
# SQLite databases and their WAL/SHM/journal sidecars — runtime state, never
# committed. The plain pattern misses the -wal/-shm suffixes, so name them.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
.cache/
.cpcache/
target/

# AOT build output: a 20MB self-contained binary plus its intermediates.
/samizdat
samizdat.build/

# Papers read while designing this. PLAN.md says what came from each.
# research/ carries third-party licensed material and stays out of git.
2*v[0-9]/
rax-results-*/
research/

# Beads is a local fallback tracker (dirge is the one in use here); its whole
# working tree — the dolt db, credentials, backups — stays out of git.
.beads/
.dolt/
*.db
.beads-credential-key

# Octave dumps its workspace here if a session exits without saving.
octave-workspace

# A draft blog post about the project, kept locally rather than shipped.
blog.md

# The design log: reasoning, measurements, and every bug found along the way.
# Kept locally rather than shipped.
PLAN.md

# jolt classpath cache, regenerated on every run
.jolt/cpcache/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# A project's own workflow and state (cells, manifests, prompts, policy,
# its database): per-project, written by samizdat on the first run.
.samizdat/
