;; The claim-text lexicon: curated wordlists AND the parameters that decide
;; how claim text is tokenized and compared, as data rather than as literals
;; baked into src (tier 1c). Read through samizdat.lexicon.
;;
;; Four readers: the relevance filter (state.clj advances-thesis?), the
;; answer-evidence gate (ship.clj answer-tokens / uncovered-tokens), the
;; ledger's near-duplicate collapse (store/artifacts.clj) and the failure
;; log's search (store/failures.clj). Every one of them decides, from words
;; the model produced, whether two pieces of text say the same thing.
;;
;; A word on a list carries no specific claim, so widening a list weakens its
;; gate; a minimum length or a similarity threshold decides what counts as a
;; match at all, so lowering one weakens the gate the same way from the other
;; side. Both kinds of value earn their place the same way, and the comments
;; recording WHY move with them: retuning without the history is how gates get
;; quietly weakened.

{:claim-relevance
 ;; The relevance guard's stopwords: grammar and framing a thesis and a
 ;; confirmed claim share regardless of whether one advances the other.
 ;; Token-intersection cannot see meaning, so these words are removed before
 ;; it runs.
 #{"the" "a" "an" "is" "are" "and" "or" "of" "for" "with" "that" "this" "it"
   "to" "in" "on" "all" "any" "can" "has" "have" "was" "were" "be" "by" "as"
   "clpfd" "prolog" "smt" "lean" "works" "available" "loaded" "basic"
   "supports" "simple" "test" "check" "verify" "verified" "example"}

 :answer-framing
 ;; Grammar plus the vocabulary a model uses to FRAME an answer rather than
 ;; to assert one. The gate is aimed at specifics — numbers, names,
 ;; witnesses — because that is where fabrication actually happens; "the
 ;; answer is" is not a claim about anything. Widening this list weakens the
 ;; gate, so entries earn their place by being framing rather than content.
 #{"the" "a" "an" "is" "are" "was" "were" "of" "for" "and" "or" "not" "no"
   "in" "on" "to" "with" "that" "this" "it" "as" "by" "at" "be" "there"
   "exists" "all" "any" "we" "have" "has" "can" "so" "if" "then" "thus"
   "answer" "solution" "solutions" "result" "results" "value" "values"
   "therefore" "hence" "conclusion" "shows" "show" "proved" "proven"
   "verified" "confirms" "confirmed" "follows" "given" "which" "where"
   "does" "do" "did" "follow" "following" "having" "from" "into" "than"
   "when" "while" "because" "since" "about" "over" "under" "between"
   "unique" "uniquely" "only" "exactly" "such" "these" "those" "each"
   "every" "must" "also" "both" "same" "case" "cases" "holds" "true" "false"

   ;; Provenance vocabulary: how the answer was checked, not what it
   ;; claims. These can never appear in an artifact, because an artifact's
   ;; claim and code are about the problem and say nothing about the engine
   ;; that ran them. Leaving them in made the gate refuse answers for
   ;; asserting the word "mathlib", which pushed the model toward stripping
   ;; every explanatory sentence to get past it — the opposite of what the
   ;; harness wants its answers to look like. The proof-engine names stay
   ;; even though the engines left: they are still provenance if they
   ;; appear.
   "lean" "mathlib" "prolog" "clpfd" "swipl" "z3" "smt" "smtlib" "octave"
   "engine" "engines" "harness" "kernel" "kernel-checked" "machine-checked"
   "theorem" "theorems" "lemma" "lemmas" "proof" "proofs" "tactic" "tactics"
   "statement" "statements" "universal" "universally" "induction" "inductive"
   "base" "step" "successor" "encoding" "encodings" "formalisation"
   "formalization" "independent" "independently" "cross-check" "cross-checked"
   ;; Generic mathematical prose. "equals" and "numbers" carry no specific
   ;; content — the specific part is the number or name they connect.
   "number" "numbers" "equal" "equals" "integer" "integers" "natural"
   "naturals" "first" "sums" "pairwise" "distinct" "positive"

   ;; The vocabulary of SCOPING an answer: saying what was and was not
   ;; settled, and how sure of it you are. What you failed to establish is,
   ;; by construction, not in your evidence; a gate that reads naming it as
   ;; asserting it makes honesty impossible (vf-w2k).
   "stated" "states" "fact" "facts" "establish" "establishes" "established"
   "evidence" "check" "checks" "checked" "unchecked" "found" "finds"
   "finding" "findings" "showed" "shown" "showing"
   "prove" "proves" "proving" "support" "supports"
   "supported" "settle" "settles" "settled" "unsettled" "unresolved"
   "resolve" "resolves" "resolved" "ask" "asks" "asked" "question"
   "questions" "answers" "answered" "unanswered" "claim" "claims"
   "claimed" "assert" "asserts" "asserted" "conclude" "concludes"
   "remain" "remains" "remaining"
   "outstanding" "together" "against" "general" "generally" "partial"
   "partially" "whenever" "conditional" "conditionally" "arbitrary"
   "computation" "computations" "computed" "search" "searched" "taken"
   "what" "branch" "branches" "verify" "verifies" "verification"
   "establishing" "demonstrate" "demonstrates" "demonstrated"
   ;; Deictics. A word that points at the document rather than at the
   ;; substance cannot be an assertion about the substance.
   "here" "above" "below" "within" "throughout"
   "reach" "reaches" "reached" "give" "gives" "yield" "yields" "open"}

 :claim-matching
 ;; How claim text is turned into something comparable, before any wordlist
 ;; is consulted. Every one of these was a bare number in src/ — under a
 ;; paragraph of justification in two cases, which reads as diligence and is
 ;; exactly as unreachable to a supervisor as an anonymous literal.
 ;;
 ;; They are the same KIND of knob as the stopword lists above: a gate that
 ;; asks "do these two claims say the same thing" answers differently when
 ;; the minimum token is three characters instead of four, and nothing about
 ;; the right answer is universal — a Lean campaign and a Rust refactor
 ;; disagree about what a meaningful token looks like.
 {:min-token-length 4
  ;; Tokens shorter than this carry no content of their own. state.clj's
  ;; relevance filter and ship.clj's answer gate both drop them.

  :min-search-token-length 3
  ;; The floor for a SEARCH term rather than a claim token, used by the
  ;; shared-artifact FTS query and the failure log. Lower than the claim
  ;; minimum on purpose: a search is ranked and recall matters more than
  ;; precision, while a gate's verdict is binary.

  :min-stem-length 5
  ;; Never singularize below this. `is` must not become `i`, and nothing may
  ;; be stemmed into a collision with a different word.

  :shingle-width 4
  ;; Words per shingle for the ledger's near-duplicate Jaccard. Wide enough
  ;; that two claims sharing ordinary phrasing do not match; narrow enough
  ;; that one rewording does not hide a duplicate.

  :near-duplicate-threshold 0.6
  ;; Jaccard at or above this and two claims are the same claim. Read live
  ;; off gen-22, where three branches proved one inequality and the ledger
  ;; listed it three times; the live duplicates differed only in variable
  ;; names and an `i.e.` for a `so`.

  :answer-token-min-length 4
  ;; ship.clj: the shortest token the answer-evidence gate will hold against
  ;; an answer. Separate from :min-token-length because this one decides
  ;; whether a SHIP is refused, and a gate that blocks delivery earns a
  ;; knob of its own.

  :answer-suffix-min-stem 5
  ;; ship.clj: never strip a suffix that would leave a stem shorter than
  ;; this.

  :answer-prefix-token-length 8
  :answer-prefix-match-length 6
  ;; ship.clj: a token this long (8) is considered covered when its first
  ;; six characters appear in the answer text. Long words survive
  ;; inflection that the suffix table does not enumerate.
  }

 :usage-cap-signals
 ;; How a provider says "you are out of budget" rather than "slow down", in
 ;; the error TEXT of a 429 — the status alone cannot tell the two apart, and
 ;; the difference decides whether the retry ladder waits or gives up. A cap
 ;; wearing a rate limit's headers cannot be waited out inside a run.
 ;;
 ;; Deliberately NARROW: misreading a rate limit as a cap costs the run. The
 ;; English signals cover OpenAI and DeepSeek; GLM/Zhipu report a daily usage
 ;; cap as error code 1308 with a Chinese 使用上限 message, and some gateways
 ;; phrase it "per-day".
 ;;
 ;; Here rather than in the adapter because it is a fact about PROVIDERS, and
 ;; providers change their error text without asking. A user hitting a new
 ;; gateway's wording should be able to add it and keep working, not wait for
 ;; a release. Kept as a string because EDN has no regex literal.
 "(?i)insufficient|quota|billing|exceeded your current|payment|per-day|daily limit|1308|使用上限|每日"

 :tool-version
 ;; A tool name followed by its version. Stripped BEFORE tokenizing,
 ;; because the version is a bare number and numbers are the part of the
 ;; answer gate that must not be relaxed — "Python 3" would otherwise
 ;; assert the number 3 and get refused for it. Narrow on purpose: only a
 ;; number directly after a known tool name. Kept as a string because EDN
 ;; has no regex literal; the consumers re-pattern it.
 "(?i)\\b(lean|mathlib|z3|swipl|swi-prolog|prolog|octave|clojure|jolt|python|node|java|deepseek)[\\s-]*[0-9]+(\\.[0-9]+)*"
 :empty-section
 ;; What a model writes when it has nothing to put in a section it was asked
 ;; to fill. A reflector told to leave GOTCHAS empty almost never leaves it
 ;; empty — it writes "None." or "N/A" or a bracketed placeholder echoed back
 ;; from the template, and every one of those becomes a memory the next run
 ;; is shown unless it is recognised here.
 ;;
 ;; A regex PATTERN STRING, re-patterned at the use site, matched against a
 ;; WHOLE line. Widening it starts eating real content — a memory that
 ;; genuinely reads "N/A on this project" is a fact — so entries earn their
 ;; place by being placeholders and nothing else.
 "(?i)none\\.?|n/?a\\.?|\\[.*\\]"

 :context-overflow
 ;; How providers word a context-window overflow (karamazov-d41). A 500
 ;; carrying one of these is DETERMINISTIC — the same oversized prompt fails
 ;; the same way every time — so it must never be retried on backoff (the
 ;; Qwen baseline burned 3 attempts x up to 32s per turn against llama-server's
 ;; wall) and instead triggers the context squeeze (gates.edn
 ;; :context-squeeze). A regex PATTERN STRING matched against the raw
 ;; response body; it has to track how endpoints actually word it:
 ;; llama.cpp says 'Context size has been exceeded', OpenAI-compatible
 ;; servers say 'maximum context length' / 'context_length_exceeded'.
 "(?i)context (size|length|window)|context_length_exceeded|maximum context"

 :shell-refusal
 ;; How the shell policy phrases a refusal. Read to turn a refused command
 ;; into a durable project fact, which is worth more than it looks: it saves
 ;; the next run the turn it would spend learning the same refusal.
 ;;
 ;; A regex PATTERN STRING, re-patterned at the use site. It matches the
 ;; TOOL RESULT, so it has to track how the policy actually words itself —
 ;; if the refusal text is reworded and this is not, the fact silently stops
 ;; being recorded and nothing fails.
 "(?i)needs approval|not on the allow list"
}
