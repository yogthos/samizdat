;; The terminal UI's arrangement, as data — the factory default of a LAYERED
;; settings file. Another tui.edn only has to say what it changes: it is merged
;; over this one key by key (a :layout is replaced whole).
;;
;; THIS IS USERSPACE. The core implements the widgets — what a conversation
;; log is, how a diff folds, where the activity trace comes from — and this
;; file decides which of them appear and where. Rearranging the UI is editing
;; EDN: no rebuild, and the agent can do it to itself at runtime through the
;; same seam that carries gates.edn and the manifests.
;;
;; WHERE THE TUI READS IT FROM, highest first, each merged over the ones below
;; (samizdat.layers):
;;
;;   1. the file $SAMIZDAT_TUI_FILE (or $SAMIZDAT_TUI_LAYOUT) names;
;;   2. .samizdat/tui.edn in the project;
;;   3. what the harness serves from GET /v1/harness/layout — the server's own
;;      project file, which is how the AGENT rearranges a front end's UI;
;;   4. ~/.config/samizdat/tui.edn — a person's own, across every project;
;;   5. this file, off the classpath, which is what draws offline.
;;
;; Every file is re-read when it changes, so an edit shows up on the next
;; frame with the TUI still running.
;;
;; The vocabulary is ftxui's own (see the ftxui-jolt README): :vbox, :hbox,
;; :border, :separator, :flex, :width, anything the toolkit draws. The only
;; tags this project adds are `:widget/*`, each standing in for one widget
;; the core implements. Every widget is optional and every one may appear
;; more than once — two conversation panes side by side is a layout, not a
;; feature.
;;
;; A tag nothing implements draws a complaint in its own box and leaves the
;; rest of the layout alone; a layout that is not hiccup at all falls back to
;; this file. A bad edit costs you a panel, never the screen.

{;; How many of the newest turns to fetch the model's PROSE for each poll.
 ;;
 ;; The branch listing deliberately leaves assistant and reasoning text out:
 ;; on one real run that was 5.5MB against 62KB of results, enough that the
 ;; panel exceeded its socket timeout and never drew at all. So the words are
 ;; fetched a turn at a time, for the turns a reader is actually on — the
 ;; newest, since a conversation is read from the bottom. Raise it to scroll
 ;; back further; every turn added is another request per poll.
 :prose-turns 12

 ;; --- the theme ---------------------------------------------------------------
 ;;
 ;; Every colour on screen, as a map from a CLASS to a STYLE. The widgets name
 ;; classes and never colours; any node in :layout below may name classes too
 ;; ({:class :critic}) or carry its own inline {:style {...}}, which wins, the
 ;; way CSS does. A style takes ftxui's attributes — :color :bg :bold :dim
 ;; :italic :underlined :inverted :strikethrough — plus :border (:rounded
 ;; :heavy :double :light :dashed) and :border-color.
 ;;
 ;; A colour is a palette name (:red :cyan :gray-dark …), a 256-colour index
 ;; (0-255), "#rgb" / "#rrggbb", or [:rgb r g b]. One ftxui cannot read is
 ;; left out and named in the status line, never drawn.
 ;;
 ;; Merged key by key across the layers, so a ~/.config/samizdat/tui.edn that
 ;; says only {:theme {:agent {:color "#ffffff"}}} changes that one colour.
 ;;
 ;; The palette is dirge's PHOSPHOR: green for the agent, cyan for you,
 ;; lavender for the critic, amber for anything that needs you.
 :theme
 {;; the frame and its panels
  :frame        {:color "#60dc8c"}
  :panel        {:border-color "#60dc8c"}
  :panel-title  {:color "#60dc8c" :bold true}
  :dim          {:color "#567460"}
  :muted        {:color "#486252"}
  :accent       {:color "#9eeeac"}
  :selected     {:color "#9eeeac" :bold true}
  :ok           {:color "#8ae89c"}
  :info         {:color "#7dcdd2"}
  :warn         {:color "#d4a860"}
  :error        {:color "#ff5f5a" :bold true}
  :complaint    {:color "#ff5f5a" :border-color "#ff5f5a"}

  ;; who is speaking
  :user         {:color "#7dcdd2"}
  :agent        {:color "#8ae89c"}
  :critic       {:color "#baa6d8"}
  :supervisor   {:color "#e0c27a"}
  :system       {:color "#6a8c78"}
  :thinking     {:color "#80968c"}

  ;; what the agent did
  :tool         {:color "#6cbc96"}
  :tool-box     {:border :rounded :border-color "#486252"}
  :error-box    {:border-color "#ff5f5a"}
  :tool-name    {:color "#6cbc96" :bold true}
  :result       {:color "#769e84"}
  :diff-add     {:color "#8ae89c" :bg 22}
  :diff-del     {:color "#ff5f5a" :bg 52}
  :diff-hunk    {:color "#567460"}
  :step         {:color "#6cbc96"}
  :step-failed  {:color "#ff5f5a"}

  ;; gauges and the footer
  :gauge        {:color "#60dc8c"}
  :gauge-hot    {:color "#ff5f5a"}
  :status       {:bg "#1a1a1a" :color "#6a8c78"}
  :status-live  {:color "#8ae89c"}
  :status-down  {:color "#ff5f5a"}
  :model        {:color "#7dcdd2"}
  :git-branch   {:color "#8ae89c"}
  :input        {:color "#ffffff"}

  ;; what the claims came to
  :claim-confirmed   {:color "#8ae89c"}
  :claim-refuted     {:color "#ff5f5a"}
  :claim-ambiguous   {:color "#d4a860"}
  :claim-existential {:color "#7dcdd2"}

  ;; somebody has to answer
  :perm         {:color "#ffb955"}
  :perm-box     {:border :heavy :border-color "#ffb955"}
  :question     {:color "#7dcdd2"}
  :question-box {:border :heavy :border-color "#7dcdd2"}}

 ;; --- the widgets in this build ---------------------------------------------
 ;;
 ;;   :widget/conversation  the agent's turns: what it said, what it called,
 ;;                         what came back. Thinking, tool arguments and diffs
 ;;                         fold; click a header to open one.
 ;;   :widget/activity      the ACTIVITY LOG — the manifest states the agent is
 ;;                         walking, newest last (:start :measure :infer :parse
 ;;                         :dispatch :journal :settle :arbiter :route).
 ;;   :widget/tasks         the board: what is open, in progress, done.
 ;;   :widget/files         files this run has written, newest first.
 ;;   :widget/context       the branch's context fill against the window, what
;;                         the run has spent, and the cache: hit rate and the
;;                         turns that missed, by cause.
 ;;   :widget/gates         gates that fired and predictions still unsettled.
 ;;   :widget/artifacts     claims made, and how each was judged.
 ;;   :widget/runs          the run picker.
 ;;   :widget/branches      the beam: every branch and what became of it.
 ;;                         Click one to read it.
 ;;   :widget/approvals     the question a person is being asked, if any: the
 ;;                         permission dialog, or ask_human's questionnaire.
 ;;                         Draws nothing when there is nothing pending.
 ;;   :widget/input         the compose box, and start / abort / resume. What
 ;;                         Enter means depends on whether a run is selected:
 ;;                         with one it is a directive for that run, with none
 ;;                         the words are the problem statement for a new run.
 ;;                         Bare by default; {:boxed true} draws a border,
 ;;                         {:title "STEER"} a titled panel.
 ;;   :widget/git           the working tree: branch, +staged ~unstaged
 ;;                         ?untracked, and the last commit's subject.
 ;;   :widget/status        the footer: project:branch, model, context fill,
 ;;                         turns, run status, run id.

 ;;   :widget/command-hints while a /command is being typed, what it could
 ;;                         be and what each does. Nothing otherwise.
 ;;   :widget/rule          a line with a title set into it, ──[ TITLE ]──.
 ;;                         The top frame is three, one over each column.
 ;;   :widget/avatar        a face saying what the agent is doing — faces
 ;;                         and which tool makes which one are :avatar below.

 ;; The conversation: who is who, and which of the journal's notes are shown
 ;; beside the turns and as whom.
 :conversation
 {;; The name each role speaks under: <you>, <agent> …
  :handles {:user "you" :agent "agent" :critic "critic"
            :supervisor "supervisor" :system "sys"}
  ;; Who issued a steer, as a role.
  :issued-by {"human" :user "supervisor" :supervisor "watch" :supervisor}
  ;; Journal notes shown in the conversation: the kind, the role it speaks
  ;; as, and the path to its words in the note's data (the whole data when
  ;; that path holds nothing). The kinds are what the branch fetch asks for.
  :notes {"critic-score"       {:role :critic :say [:reply]}
          "critique"           {:role :critic :say [:findings]}
          "review"             {:role :critic :say [:decision]}
          "oversight"          {:role :supervisor :say [:notes]}
          "watch-intervention" {:role :supervisor :say [:finding]}
          "compaction"         {:role :system :say [:action]}
          "llm-switch"         {:role :system :say [:summary]}}
  ;; The argument a tool call is known by in its chamber's header.
  :banner {"read_file" "path" "write_file" "path" "edit_file" "path"
           "read_digest" "path" "patch" "path" "shell" "command"
           "grep" "pattern" "glob" "pattern" "eval" "code"}
  ;; How many lines of a result show before the rest folds.
  :result-lines 4}

 ;; SLASH COMMANDS, typed into the compose box; Tab completes a name, and
 ;; /help lists them. Each says what it DOES (an action the TUI implements),
 ;; its arguments and its help line; {:alias "/model"} is a second name.
 ;;
 ;;   :do :intervene sends a directive to the run on screen, of :kind, with
 ;;   the argument as its payload, aimed by :target — :branch (the branch on
 ;;   screen), :arg (the argument names the branch) or nothing (the run).
 :commands
 {"/help"     {:do :help :doc "these commands"}
  "/quit"     {:do :quit :doc "leave (Ctrl+Q)"}
  "/model"    {:do :model :args "[role] [model]"
               :doc "list the models, or switch: `/model glm-5.3` for every role, `/model critic glm:glm-5.3` for one — live for the run on screen, else the next run"}
  "/effort"   {:do :effort :args "[role] <low|medium|high|max>"
               :doc "how hard the model thinks, for every role or one — live for the run on screen, else the next run"}
  "/mode"     {:do :mode :args "[refuse|block]"
               :doc "when a run needs you: refuse, or block and ask"}
  "/run"      {:do :start :args "<problem>" :doc "start a run on a problem"}
  "/abort"    {:do :abort :doc "abort the run on screen"}
  "/resume"   {:do :resume :doc "resume the run on screen"}
  "/runs"     {:do :runs :args "[id]" :doc "list the runs, or open one by the start of its id"}
  "/branch"   {:do :branch :args "<id>" :doc "read another branch of the beam"}
  "/follow"   {:do :follow :doc "back to the newest entry (End)"}
  "/clear"    {:do :clear :doc "clear what this TUI printed"}
  "/steer"    {:do :intervene :kind "message" :target :branch :args "<text>"
               :doc "say something to the branch on screen, at its next turn"}
  "/review"   {:do :intervene :kind "review" :target :branch
               :doc "tell the branch to cross-check and ship what it has"}
  "/cull"     {:do :intervene :kind "cull" :target :arg :args "<branch>"
               :doc "stop a branch"}
  "/fork"     {:do :intervene :kind "fork" :args "<thesis>"
               :doc "open a sibling branch on a thesis"}
  "/extend"   {:do :intervene :kind "extend" :args "<turns>"
               :doc "raise the run's turn cap"}
  "/pause"    {:do :intervene :kind "pause" :doc "stop scheduling new turns"}
  "/continue" {:do :intervene :kind "resume" :doc "schedule turns again after /pause"}
  "/switch"   {:do :intervene :kind "switch" :args "<board|team|decompose>"
               :doc "the feature loop's strategy for its next round"}
  "/budget"   {:do :intervene :kind "budget" :args "<turns>"
               :doc "the per-owner turn budget for the feature loop's next rounds"}
  "/stop"     {:do :intervene :kind "stop" :args "<why>"
               :doc "end the run unsolved at the feature loop's next round"}
  "/q"        {:alias "/quit"}}

 ;; DESKTOP NOTIFICATIONS, after dirge's: when the run on screen needs you
 ;; (a permission question, ask_human), and when it ends. :on picks the
 ;; moments — "question", "run-finished" — and an empty set turns them off.
 ;; :command, when set, is the program to run, with {title} and {body}
 ;; filled in, e.g. ["terminal-notifier" "-title" "{title}" "-message" "{body}"];
 ;; unset, osascript on macOS and notify-send elsewhere.
 :notifications {:on #{"question" "run-finished"}}

 ;; The avatar's faces, by mood, and the tools that set one. A mood no tool
 ;; names is :thinking while a run is going.
 :avatar
 {:faces {:idle     "(o o)"
          :thinking "(o .)"
          :reading  "[@ @]"
          :writing  "(>_<)"
          :shell    "[$_$]"
          :alert    "(O_O)"
          :error    "(x_x)"
          :done     "(^_^)"}
  :tools {"read_file" :reading "read_digest" :reading "grep" :reading
          "glob" :reading "lsp" :reading "fetch_turn" :reading
          "write_file" :writing "edit_file" :writing "patch" :writing
          "shell" :shell "eval" :shell}}

 ;; THE ARRANGEMENT, after dirge: a top frame naming the three columns; the
 ;; run's vitals on the left; the conversation in the middle, where the room
 ;; is; the work in progress on the right; the avatar beside the compose box;
 ;; the status line under everything.
 ;;
 ;; ONE FLEXED PANEL PER COLUMN. A bare :height is an EQUALITY constraint in
 ;; ftxui, so a stack of pinned boxes cannot shrink to fit and the ones at the
 ;; bottom are squeezed to nothing — five pinned in one gutter once drew three
 ;; of them as empty rules. Each column below pins the rest and flexes one.

 :layout
 [:vbox {:flex true}

  ;; THE CHAT COLUMN IS CAPPED, as dirge's is: 120 columns, which it gives up
  ;; on a narrow terminal (:flex :shrink), while the side columns — at least
  ;; 32 and 34 wide, :grow — share whatever room is left on a wide one. Each
  ;; column carries its own title in the top frame, so the titles stay over
  ;; their columns at any width; the bottom strip uses the same widths so the
  ;; compose box stays under the conversation.
  [:hbox {:flex true}

   ;; Left: what the run is spending and doing, and the beam — which branch
   ;; the conversation beside it is.
   [:vbox {:width [:>= 32] :flex :grow}
    [:widget/rule {:title "RUN STATUS"}]
    [:text {:class :panel-title :align :hcenter} "S A M I Z D A T"]
    [:widget/context {:title "CONTEXT" :height 11}]
    [:widget/activity {:title "ACTIVITY" :flex :grow}]
    [:widget/branches {:title "BEAM" :height 7}]]

   ;; The middle: the conversation; while a /command is typed, what it could
   ;; be; when somebody has to answer, the question; and the run's own
   ;; account of itself — its claims, and the gates it was advised by and
   ;; has not answered — in a wide short row. `:turns` is how far back the
   ;; conversation draws.
   [:vbox {:width 120 :flex :shrink}
    [:widget/rule {:title "AGENT LOG"}]
    [:widget/conversation {:flex true :turns 60}]
    [:widget/command-hints {}]
    [:widget/approvals {}]
    [:hbox {:height 6}
     [:widget/artifacts {:title "CLAIMS" :flex true}]
     [:widget/gates {:title "GATES" :flex true}]]]

   ;; Right: which run, the board, what has changed, and the tree it is
   ;; changing. GIT needs three rows inside its chrome, hence 7.
   [:vbox {:width [:>= 34] :flex :grow}
    [:widget/rule {:title "HARNESS"}]
    [:widget/runs {:title "RUNS" :height 6}]
    [:widget/tasks {:title "TASKS" :height 8}]
    [:widget/files {:title "MODIFIED" :flex :grow}]
    [:widget/git {:title "GIT" :height 7}]]]

  ;; The avatar and the compose box. No height: the strip is as tall as the
  ;; box, which grows a row per line typed (Ctrl+J) up to :max-lines.
  [:hbox
   [:widget/avatar {:width [:>= 32] :flex :grow}]
   [:widget/input {:width 120 :flex :shrink :boxed true :max-lines 8}]
   [:filler {:width [:>= 34] :flex :grow}]]

  [:widget/status {}]]}
